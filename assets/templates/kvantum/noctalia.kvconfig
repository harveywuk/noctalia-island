# Kvantum overrides (Qt control shapes and colours)
# Generated by Noctalia's Template Processor
#
# apply.sh merges these keys into a copy of Kvantum's macOS-style KvMojave theme and saves the
# result as the "Noctalia" Kvantum theme. [%Noctalia] is read by apply.sh and not passed on.

[%Noctalia]
accent={{colors.primary.default.hex}}
accent_dark={{colors.primary.default.hex | darken 8}}
accent_light={{colors.primary.default.hex | lighten 20}}
window={{colors.surface.default.hex}}

# macOS-proportioned controls, matching the shell's own (src/ui/style.h): 16px checkboxes and
# radios, a 4px slider track with a 20px knob.
[%General]
check_size=16
slider_width=4
slider_handle_width=20
slider_handle_length=20
progressbar_thickness=4
layout_spacing=6
small_icon_size=16
button_icon_size=16
translucent_windows=false
blurring=false
popup_blurring=false

[GeneralColors]
window.color={{colors.surface.default.hex}}
inactive.window.color={{colors.surface.default.hex}}
base.color={{colors.surface_variant.default.hex}}
inactive.base.color={{colors.surface_variant.default.hex}}
alt.base.color={{colors.surface_container.default.hex}}
inactive.alt.base.color={{colors.surface_container.default.hex}}
button.color={{colors.surface_variant.default.hex}}
highlight.color={{colors.primary.default.hex}}
inactive.highlight.color={{colors.primary.default.hex}}
highlight.text.color={{colors.on_primary.default.hex}}
inactive.highlight.text.color={{colors.on_primary.default.hex}}
text.color={{colors.on_surface.default.hex}}
inactive.text.color={{colors.on_surface.default.hex}}
window.text.color={{colors.on_surface.default.hex}}
inactive.window.text.color={{colors.on_surface.default.hex}}
button.text.color={{colors.on_surface.default.hex}}
disabled.text.color={{colors.on_surface_variant.default.hex}}
tooltip.base.color={{colors.surface_container.default.hex}}
tooltip.text.color={{colors.on_surface.default.hex}}
link.color={{colors.primary.default.hex}}
link.visited.color={{colors.tertiary.default.hex}}


# Selected list rows take the accent, as on macOS.
[ItemView]
text.toggle.color={{colors.on_primary.default.hex}}
text.press.color={{colors.on_primary.default.hex}}
text.toggle.inactive.color={{colors.on_primary.default.hex}}
